# =====================================================================
# Настройки интеграции со Stepik API (Необязательно)
# =====================================================================
# Чтобы включить интеграцию:
# 1. Зарегистрируйте OAuth2 приложение на странице:
#    https://stepik.org/oauth2/applications/
#    - Client type: Confidential
#    - Authorization grant type: Client credentials
# 2. Скопируйте этот файл в .env:
#    cp .env.example .env
# 3. Заполните переменные ниже и перезапустите dev-сервер.

VITE_STEPIK_ENABLED="false"
VITE_STEPIK_CLIENT_ID="ваш_client_id"
VITE_STEPIK_CLIENT_SECRET="ваш_client_secret"

# =====================================================================
# Настройки Supabase Auth & Cloud Database
# =====================================================================
# 1. Создайте бесплатный проект на https://supabase.com
# 2. В Project Settings -> API скопируйте Project URL и anon public key
# 3. Для корпоративной почты: Project Settings -> Authentication -> SMTP Settings
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

